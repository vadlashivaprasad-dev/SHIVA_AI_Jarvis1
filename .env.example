# ShivaAI Jarvis Environment Configuration
# Copy this to .env and update with your actual values
# CRITICAL: Change all secrets before deploying to production!

# ===== APPLICATION =====
ENVIRONMENT=development
DEBUG=false
VITE_API_URL=http://localhost:8000
APP_NAME=ShivaAI Jarvis
APP_VERSION=1.0.0

# ===== DATABASE =====
# Development (SQLite)
DATABASE_URL=sqlite:///./data/gateway.db
# Production (PostgreSQL) - USE THIS FOR PRODUCTION
# DATABASE_URL=postgresql://user:password@localhost:5432/shivaai_prod
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# ===== SECURITY - CRITICAL =====
# IMPORTANT: Generate secure JWT_SECRET with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
SESSION_TIMEOUT_MINUTES=30

# ===== RATE LIMITING & AUTH =====
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ===== CHAT CONFIG =====
ALLOW_PUBLIC_CHAT=false
MAX_MESSAGE_LENGTH=8000

# ===== LLM PROVIDER =====
# Options: local, openai, anthropic, ollama
LLM_PROVIDER=local
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_RETRIES=3

# ===== OPENAI CONFIG (if using OpenAI) =====
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo
OPENAI_TIMEOUT=45.0

# ===== VECTOR DATABASE (QDRANT) =====
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ===== REDIS CACHE =====
REDIS_URL=redis://localhost:6379/0

# ===== NEO4J GRAPH DATABASE =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=shivaai_dev_pass

# ===== CORS & API =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_PREFIX=/api/v1

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== SECURITY HEADERS =====
ENABLE_CORS=true
ENABLE_HTTPS_REDIRECT=false
ALLOWED_HOSTS=*
ENABLE_REQUEST_SIGNING=false

# ===== FEATURE FLAGS =====
ENABLE_VECTOR_SEARCH=true
ENABLE_AUDIT_LOGGING=true


