# ============================================================
# ShivaAI Jarvis — Environment Configuration
# ============================================================
# 1. cp .env.example .env
# 2. Fill in all values marked CHANGE_ME
# 3. Never commit .env to git!
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# ===== APPLICATION =====
ENVIRONMENT=development
DEBUG=false
APP_NAME=ShivaAI Jarvis
APP_VERSION=1.0.0
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# ===== POSTGRESQL =====
POSTGRES_USER=shivaai
POSTGRES_PASSWORD=CHANGE_ME                         # min 16 chars
POSTGRES_DB=shivaai
# Full URL is auto-constructed in docker-compose from above vars.
# Use this for local dev (outside Docker) or production overrides:
# DATABASE_URL=postgresql://shivaai:CHANGE_ME@localhost:5432/shivaai
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# ===== REDIS =====
REDIS_PASSWORD=CHANGE_ME                            # min 16 chars
# Full URL auto-constructed in docker-compose. Override if needed:
# REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# ===== QDRANT VECTOR DB =====
QDRANT_API_KEY=CHANGE_ME
# QDRANT_URL=http://localhost:6333                  # outside Docker

# ===== NEO4J GRAPH DB =====
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME                            # min 16 chars
# NEO4J_URI=bolt://localhost:7687                   # outside Docker

# ===== SECURITY — CRITICAL =====
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
SESSION_TIMEOUT_MINUTES=30

# ===== RATE LIMITING =====
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ===== LLM PROVIDER =====
# Options: ollama, openai, anthropic, local
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_RETRIES=3

# ===== OLLAMA (default, local) =====
OLLAMA_BASE_URL=http://ollama:11434               # inside Docker
OLLAMA_MODEL=tinyllama
# OLLAMA_BASE_URL=http://localhost:11434           # outside Docker

# ===== OPENAI (optional) =====
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=45.0

# ===== ANTHROPIC (optional) =====
ANTHROPIC_API_KEY=

# ===== FRONTEND =====
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ===== CHAT =====
ALLOW_PUBLIC_CHAT=false
MAX_MESSAGE_LENGTH=8000

# ===== CORS & API =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_PREFIX=/api/v1
ALLOWED_HOSTS=*

# ===== SECURITY HEADERS =====
ENABLE_CORS=true
ENABLE_HTTPS_REDIRECT=false                        # set true in production
ENABLE_REQUEST_SIGNING=false

# ===== FEATURE FLAGS =====
ENABLE_VECTOR_SEARCH=true
ENABLE_AUDIT_LOGGING=true
